{
  "manifest_version": 3,
  "name": "Google Optimizer",
  "version": "3.2.0",
  "description": "Locks Instagram to DMs, blocks Shorts, Facebook and Threads, keeps YouTube in focus mode, and tells you when Claude finishes.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Optimizer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "settings.js",
        "blocker.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.threads.net/*",
        "*://*.threads.com/*"
      ],
      "js": [
        "settings.js",
        "blocker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "claude.js"
      ]
    }
  ],
  "host_permissions": [
    "*://*.instagram.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "instagram_frames",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}